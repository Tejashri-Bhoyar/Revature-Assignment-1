weatherforcst.proto

syntax = "proto3";

package weather;

service WeatherService {
  rpc GetForecast (ForecastRequest) returns (ForecastReply);
}

message ForecastRequest {
  string city = 1;
}

message ForecastReply {
  string forecast = 1;
  int32 temperatureC = 2;
  int32 temperatureF = 3;
}



var builder = WebApplication.CreateBuilder(args);

builder.Services.AddGrpc();

var app = builder.Build();
app.MapGrpcService<WeatherServiceImpl>();
app.MapGet("/", () => "gRPC service running");

app.Run();


public class WeatherServiceImpl : WeatherService.WeatherServiceBase
{
    public override Task<ForecastReply> GetForecast(ForecastRequest request, ServerCallContext context)
    {
        var reply = new ForecastReply
        {
            Forecast = $"Sunny in {request.City}",
            TemperatureC = 25,
            TemperatureF = 77
        };
        return Task.FromResult(reply);
    }
}
